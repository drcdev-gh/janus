# PocketID
# Base URL of your PocketID instance (no trailing slash)
POCKETID_API_URL=https://id.example.com

# Admin API key — generate one at /settings/api-keys in the PocketID UI
POCKETID_API_KEY=your-pocketid-api-key

# Outline
# Base URL of your Outline instance (no trailing slash)
OUTLINE_API_URL=https://outline.example.com

# Outline API token — create one at /settings/api in the Outline UI
# Required permissions: groups.create groups.list groups.delete
#   groups.memberships groups.add_user groups.remove_user
#   users.list users.suspend users.activate
OUTLINE_API_KEY=ol_api_your-outline-api-key

# SSH
# Name of the PocketID group whose members are allowed SSH access.
# Must match the group name exactly as it appears in PocketID.
SSH_ALLOWED_GROUP=SSH Users

# Janus
# Shared secret used to authenticate requests to the /outline/sync
# and /ssh/validate endpoints. Use a long random string.
API_KEY=change-me
